# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Group id: a negative number like -1001234567890
GROUP_ID=-1001234567890
# Your own Telegram user id (the admin who may /export)
ADMIN_ID=123456789
TZ=Europe/Riga
# Local runs: bot.sqlite next to the code. Docker overrides this to /app/data/bot.sqlite
DB_PATH=bot.sqlite
